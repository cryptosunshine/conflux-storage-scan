{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "conflux-storage-scan",
	"compatibility_date": "2026-07-28",
	"main": "src/storage-node-proxy/worker.ts",
	// Cloudflare Workers cannot fetch direct IP addresses. Set STORAGE_NODE_UPSTREAM_URLS
	// in the dashboard to a JSON array of hostname URLs backed by DNS-only A records.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/storage-node/*"]
	}
}
